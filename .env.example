# انسخ هذا الملف باسم .env وحط فيه مفتاحك الحقيقي
# Copy this file to ".env" and put your real key inside

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx

# المنفذ اللي السيرفر هيشتغل عليه (اختياري)
PORT=3000

# الدومين بتاع موقعك (عشان CORS) — مثال: https://webcodekit.com
# لو شغّال على localhost سيبه كما هو
ALLOWED_ORIGIN=http://localhost:3000
